#!/usr/bin/env bash
#MISE description="Generate e2e git repo fixture tarballs under test/e2e/fixtures/repos/"

set -e

FIXTURES_DIR="test/e2e/fixtures/repos"
SCRIPTS_DIR="${MISE_TASK_DIR}"

mkdir -p "$FIXTURES_DIR"

generate_fixture() {
    local name=$1
    local setup_script="$SCRIPTS_DIR/$name"

    echo "Generating $name fixture..."

    if [ ! -f "$setup_script" ]; then
        echo "Error: Setup script $setup_script not found"
        exit 1
    fi


    tmpdir=$(mktemp -d)

    export REPO_DIR="$tmpdir"
    bash "$setup_script" "$tmpdir"

    tar -czf "$FIXTURES_DIR/$name.tar.gz" -C "$tmpdir" .

    rm -rf "$tmpdir"
    echo "✓ Created $name.tar.gz"
}

generate_fixture "bare-main"
generate_fixture "single-branch"
generate_fixture "multi-branch"
generate_fixture "corrupted"
generate_fixture "submodule"
generate_fixture "detached"

echo ""
echo "All fixtures generated successfully!"